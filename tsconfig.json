{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    // src の相互 import に .ts を付ける。付けないと Node から直接読めず、
    // scripts/e2e-local.mjs（実 HTTP 越しの通し確認）が動かない
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"],
  // クライアントは DOM の型が要るので tsconfig.client.json で別に検査する。
  // ⚠ test/ からクライアントのモジュールを import すると、ここへ引き込まれて
  // DOM の型が無いまま検査される。**DOM を使うモジュールを触るテストは
  // 個別に除外して、client 側の include へ足す**（DOM をここへ足してはいけない）。
  "exclude": ["src/client/**/*.ts", "test/local-store.test.ts"]
}
