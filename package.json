{
  "name": "michizure",
  "version": "0.1.0",
  "description": "Michizure（道連れ）— 旅行費用の精算Webサービス",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "pretest": "node scripts/check-privacy-config.mjs && node scripts/check-wordlist.mjs",
    "build:wordlist": "node scripts/build-wordlist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "build:client": "esbuild src/client/app.ts --bundle --format=esm --outfile=public/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waiteu-git/michizure.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
